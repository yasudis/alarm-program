{
  "App": {
    "ApplicationName": "Alarm Program",
    "Environment": "Development"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "File": {
      "Path": "%AppData%/AlarmProgram/logs/alarm-.log",
      "RetainedFileCountLimit": 14
    }
  },
  "Notifications": {
    "DefaultRetryCount": 3,
    "RetryDelaySeconds": 2
  },
  "Monitoring": {
    "PollIntervalSeconds": 30,
    "InitialLookbackMinutes": 10,
    "RecoveryLookbackHours": 24,
    "DeduplicationWindowSeconds": 180,
    "DefaultHeartbeatIntervalMinutes": 60
  },
  "AlertJournal": {
    "FilePath": "%AppData%/AlarmProgram/alert-journal.json",
    "MaxEntries": 100
  }
}
