{
  "App": {
    "ApplicationName": "Alarm Program",
    "Environment": "Development"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "File": {
      "Path": "%AppData%/AlarmProgram/logs/alarm-.log",
      "RetainedFileCountLimit": 14
    }
  },
  "Notifications": {
    "DefaultRetryCount": 3,
    "RetryDelaySeconds": 2
  }
}
