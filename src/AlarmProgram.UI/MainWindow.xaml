<Window x:Class="AlarmProgram.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding ApplicationTitle}"
        Height="820"
        Width="820"
        MinHeight="620"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        StateChanged="OnWindowStateChanged"
        Closing="OnWindowClosing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding ApplicationTitle}"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="14"
                CornerRadius="8"
                Background="#FFF5F5F5">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <Button Width="140"
                            Height="30"
                            Content="Пауза"
                            Command="{Binding PauseMonitoringCommand}" />
                    <Button Width="140"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="Возобновить"
                            Command="{Binding ResumeMonitoringCommand}" />
                    <Button Width="140"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="Открыть логи"
                            Command="{Binding OpenLogsFolderCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="15"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="16"
                CornerRadius="8"
                Background="#FFFDFDFD"
                BorderBrush="#FFE3E3E3"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="Настройки уведомлений" />

                    <CheckBox Margin="0,16,0,0"
                              Content="Включить Telegram"
                              IsChecked="{Binding Settings.TelegramEnabled}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Telegram Bot Token" />
                    <TextBox Text="{Binding Settings.TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Telegram Chat ID" />
                    <TextBox Text="{Binding Settings.TelegramChatId, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Margin="0,16,0,0"
                              Content="Включить Discord webhook"
                              IsChecked="{Binding Settings.DiscordEnabled}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Discord Webhook URL" />
                    <TextBox Text="{Binding Settings.DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,16,0,0"
                               FontWeight="SemiBold"
                               Text="Типы событий" />
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Margin="0,0,16,8"
                                  Content="Startup"
                                  IsChecked="{Binding Settings.NotifyOnStartup}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Shutdown"
                                  IsChecked="{Binding Settings.NotifyOnShutdown}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Restart"
                                  IsChecked="{Binding Settings.NotifyOnRestart}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Unexpected shutdown"
                                  IsChecked="{Binding Settings.NotifyOnUnexpectedShutdown}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="User logon"
                                  IsChecked="{Binding Settings.NotifyOnUserLogon}" />
                    </WrapPanel>

                    <TextBlock Margin="0,8,0,0"
                               FontWeight="SemiBold"
                               Text="Фон и автозапуск" />
                    <CheckBox Margin="0,8,0,0"
                              Content="Запускать вместе с Windows"
                              IsChecked="{Binding Settings.RunAtWindowsStartup}" />
                    <CheckBox Margin="0,8,0,0"
                              Content="Сворачивать в системный трей"
                              IsChecked="{Binding Settings.MinimizeToTray}" />
                    <CheckBox Margin="0,8,0,0"
                              Content="Heartbeat (ПК в сети)"
                              IsChecked="{Binding Settings.HeartbeatEnabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Text="Интервал heartbeat (мин):" />
                        <TextBox Width="80"
                                 Margin="8,0,0,0"
                                 Text="{Binding Settings.HeartbeatIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <CheckBox Margin="0,12,0,0"
                              Content="Тихие часы (кроме unexpected shutdown)"
                              IsChecked="{Binding Settings.QuietHoursEnabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Text="С" />
                        <TextBox Width="70"
                                 Margin="8,0,0,0"
                                 Text="{Binding Settings.QuietHoursStart, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="до" />
                        <TextBox Width="70"
                                 Margin="8,0,0,0"
                                 Text="{Binding Settings.QuietHoursEnd, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0"
                               Foreground="#FFB00020"
                               TextWrapping="Wrap"
                               Text="{Binding Settings.ValidationMessage}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF005A20"
                               TextWrapping="Wrap"
                               Text="{Binding Settings.SaveResultMessage}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF1A1A8A"
                               TextWrapping="Wrap"
                               Text="{Binding Settings.TestResultMessage}" />

                    <WrapPanel Margin="0,16,0,0">
                        <Button Width="180"
                                Height="34"
                                Content="Сохранить настройки"
                                Command="{Binding Settings.SaveSettingsCommand}" />
                        <Button Width="180"
                                Height="34"
                                Margin="12,0,0,0"
                                Content="Тестовая отправка"
                                Command="{Binding Settings.SendTestAlertCommand}" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="16"
                CornerRadius="8"
                Background="#FFFDFDFD"
                BorderBrush="#FFE3E3E3"
                BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Width="120"
                            Height="28"
                            Content="Обновить"
                            Command="{Binding RefreshJournalCommand}" />
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="Журнал последних алертов" />
                </DockPanel>
                <ListView ItemsSource="{Binding RecentAlerts}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Время" Width="150"
                                            DisplayMemberBinding="{Binding Timestamp}" />
                            <GridViewColumn Header="Тип" Width="120"
                                            DisplayMemberBinding="{Binding EventType}" />
                            <GridViewColumn Header="Статус" Width="80"
                                            DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="Канал" Width="90"
                                            DisplayMemberBinding="{Binding Channel}" />
                            <GridViewColumn Header="Тема" Width="240"
                                            DisplayMemberBinding="{Binding Subject}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</Window>
