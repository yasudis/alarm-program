<Window x:Class="AlarmProgram.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding ApplicationTitle}"
        Height="900"
        Width="860"
        MinHeight="680"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        StateChanged="OnWindowStateChanged"
        Closing="OnWindowClosing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding ApplicationTitle}"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="14"
                CornerRadius="8"
                Background="#FFF5F5F5">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right">
                    <Button Width="140"
                            Height="30"
                            Content="Пауза"
                            Command="{Binding PauseMonitoringCommand}" />
                    <Button Width="140"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="Возобновить"
                            Command="{Binding ResumeMonitoringCommand}" />
                    <Button Width="140"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="Открыть логи"
                            Command="{Binding OpenLogsFolderCommand}" />
                    <Button Width="150"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="Тишина 30 мин"
                            Command="{Binding MuteFor30MinutesCommand}" />
                    <Button Width="150"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="Отправить статус"
                            Command="{Binding SendStatusSnapshotCommand}" />
                    <Button Width="160"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="Копировать диагн."
                            Command="{Binding CopyDiagnosticsCommand}" />
                    <Button Width="140"
                            Height="30"
                            Margin="8,0,0,0"
                            Content="Снять тишину"
                            Command="{Binding ClearMuteCommand}" />
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBox Width="70"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SnoozeUntilTime, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Width="130"
                                Height="30"
                                Margin="8,0,0,0"
                                Content="Тишина до…"
                                Command="{Binding SnoozeUntilSpecifiedTimeCommand}" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="15"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="16"
                CornerRadius="8"
                Background="#FFFDFDFD"
                BorderBrush="#FFE3E3E3"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="Настройки уведомлений" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF8A5A00"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{Binding SetupHint}" />

                    <TextBlock Margin="0,12,0,0" Text="Отображаемое имя устройства" />
                    <TextBox Text="{Binding Settings.DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Margin="0,16,0,0"
                              Content="Включить Telegram"
                              IsChecked="{Binding Settings.TelegramEnabled}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Telegram Bot Token" />
                    <TextBox Text="{Binding Settings.TelegramBotToken, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Telegram Chat ID (несколько через запятую)" />
                    <TextBox Text="{Binding Settings.TelegramChatId, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Margin="0,16,0,0"
                              Content="Включить Discord webhook"
                              IsChecked="{Binding Settings.DiscordEnabled}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Discord Webhook URL" />
                    <TextBox Text="{Binding Settings.DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Margin="0,16,0,0"
                              Content="Включить HTTPS webhook"
                              IsChecked="{Binding Settings.WebhookEnabled}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="HTTPS Webhook URL" />
                    <TextBox Text="{Binding Settings.WebhookUrl, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Margin="0,16,0,0"
                              Content="Включить Email (SMTP)"
                              IsChecked="{Binding Settings.EmailEnabled}" />
                    <TextBlock Margin="0,8,0,0" Text="SMTP-хост" />
                    <TextBox Text="{Binding Settings.SmtpHost, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Text="Порт:" />
                        <TextBox Width="70"
                                 Margin="8,0,16,0"
                                 Text="{Binding Settings.SmtpPort, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox VerticalAlignment="Center"
                                  Content="SSL/TLS"
                                  IsChecked="{Binding Settings.SmtpUseSsl}" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Text="SMTP-логин (опционально)" />
                    <TextBox Text="{Binding Settings.SmtpUser, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,8,0,0" Text="SMTP-пароль" />
                    <TextBox Text="{Binding Settings.SmtpPassword, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,8,0,0" Text="Отправитель (From)" />
                    <TextBox Text="{Binding Settings.SmtpFrom, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,8,0,0" Text="Получатели (To, несколько через запятую)" />
                    <TextBox Text="{Binding Settings.SmtpTo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,16,0,0"
                               FontWeight="SemiBold"
                               Text="Типы событий" />
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Margin="0,0,16,8"
                                  Content="Startup"
                                  IsChecked="{Binding Settings.NotifyOnStartup}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Shutdown"
                                  IsChecked="{Binding Settings.NotifyOnShutdown}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Restart"
                                  IsChecked="{Binding Settings.NotifyOnRestart}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Unexpected shutdown"
                                  IsChecked="{Binding Settings.NotifyOnUnexpectedShutdown}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="User logon"
                                  IsChecked="{Binding Settings.NotifyOnUserLogon}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="User logoff"
                                  IsChecked="{Binding Settings.NotifyOnUserLogoff}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="IP change"
                                  IsChecked="{Binding Settings.NotifyOnIpChange}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Network offline"
                                  IsChecked="{Binding Settings.NotifyOnNetworkOffline}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Network online"
                                  IsChecked="{Binding Settings.NotifyOnNetworkOnline}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="System resume"
                                  IsChecked="{Binding Settings.NotifyOnSystemResume}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Session lock"
                                  IsChecked="{Binding Settings.NotifyOnSessionLock}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Session unlock"
                                  IsChecked="{Binding Settings.NotifyOnSessionUnlock}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Low disk space"
                                  IsChecked="{Binding Settings.NotifyOnLowDiskSpace}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Battery low"
                                  IsChecked="{Binding Settings.NotifyOnBatteryLow}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="AC power lost"
                                  IsChecked="{Binding Settings.NotifyOnAcPowerLost}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="AC power restored"
                                  IsChecked="{Binding Settings.NotifyOnAcPowerRestored}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Process down"
                                  IsChecked="{Binding Settings.NotifyOnProcessDown}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="High CPU"
                                  IsChecked="{Binding Settings.NotifyOnHighCpu}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="High memory"
                                  IsChecked="{Binding Settings.NotifyOnHighMemory}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="RDP connected"
                                  IsChecked="{Binding Settings.NotifyOnRdpConnected}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="RDP disconnected"
                                  IsChecked="{Binding Settings.NotifyOnRdpDisconnected}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Service down"
                                  IsChecked="{Binding Settings.NotifyOnServiceDown}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="USB connected"
                                  IsChecked="{Binding Settings.NotifyOnUsbConnected}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="USB disconnected"
                                  IsChecked="{Binding Settings.NotifyOnUsbDisconnected}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Failed logon"
                                  IsChecked="{Binding Settings.NotifyOnFailedLogon}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Application crash"
                                  IsChecked="{Binding Settings.NotifyOnApplicationCrash}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Reboot pending"
                                  IsChecked="{Binding Settings.NotifyOnRebootPending}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Application hang"
                                  IsChecked="{Binding Settings.NotifyOnApplicationHang}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Defender threat"
                                  IsChecked="{Binding Settings.NotifyOnDefenderThreat}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Windows Update failed"
                                  IsChecked="{Binding Settings.NotifyOnWindowsUpdateFailed}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Disk error"
                                  IsChecked="{Binding Settings.NotifyOnDiskError}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Status snapshot"
                                  IsChecked="{Binding Settings.NotifyOnStatusSnapshot}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="BSOD / bugcheck"
                                  IsChecked="{Binding Settings.NotifyOnBsod}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="User account created"
                                  IsChecked="{Binding Settings.NotifyOnUserAccountCreated}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Admin group changed"
                                  IsChecked="{Binding Settings.NotifyOnAdminGroupChanged}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Firewall disabled"
                                  IsChecked="{Binding Settings.NotifyOnFirewallDisabled}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Host unreachable"
                                  IsChecked="{Binding Settings.NotifyOnHostUnreachable}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Host restored"
                                  IsChecked="{Binding Settings.NotifyOnHostRestored}" />
                        <CheckBox Margin="0,0,16,8"
                                  Content="Custom Event IDs"
                                  IsChecked="{Binding Settings.NotifyOnCustomEvent}" />
                    </WrapPanel>

                    <TextBlock Margin="0,8,0,0"
                               FontWeight="SemiBold"
                               Text="Фон и автозапуск" />
                    <CheckBox Margin="0,8,0,0"
                              Content="Запускать вместе с Windows"
                              IsChecked="{Binding Settings.RunAtWindowsStartup}" />
                    <CheckBox Margin="0,8,0,0"
                              Content="Сворачивать в системный трей"
                              IsChecked="{Binding Settings.MinimizeToTray}" />
                    <CheckBox Margin="0,8,0,0"
                              Content="Звук при критичных алертах (даже без сети)"
                              IsChecked="{Binding Settings.PlaySoundOnCriticalAlerts}" />
                    <CheckBox Margin="0,8,0,0"
                              Content="Balloon в трее при критичных алертах"
                              IsChecked="{Binding Settings.ShowTrayBalloonOnCriticalAlerts}" />
                    <CheckBox Margin="0,8,0,0"
                              Content="Heartbeat (ПК в сети)"
                              IsChecked="{Binding Settings.HeartbeatEnabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Text="Интервал heartbeat (мин):" />
                        <TextBox Width="80"
                                 Margin="8,0,0,0"
                                 Text="{Binding Settings.HeartbeatIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <CheckBox Margin="0,12,0,0"
                              Content="Ежедневный дайджест алертов"
                              IsChecked="{Binding Settings.DailyDigestEnabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Text="Время дайджеста:" />
                        <TextBox Width="70"
                                 Margin="8,0,0,0"
                                 Text="{Binding Settings.DailyDigestTime, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <CheckBox Margin="0,12,0,0"
                              Content="Еженедельный дайджест"
                              IsChecked="{Binding Settings.WeeklyDigestEnabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Text="День:" />
                        <TextBox Width="90"
                                 Margin="8,0,16,0"
                                 Text="{Binding Settings.WeeklyDigestDay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Text="Время:" />
                        <TextBox Width="70"
                                 Margin="8,0,0,0"
                                 Text="{Binding Settings.WeeklyDigestTime, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <CheckBox Margin="0,12,0,0"
                              Content="Только критичные алерты (остальные типы подавляются)"
                              IsChecked="{Binding Settings.CriticalAlertsOnly}" />

                    <CheckBox Margin="0,12,0,0"
                              Content="Тихие часы (кроме unexpected shutdown)"
                              IsChecked="{Binding Settings.QuietHoursEnabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Text="С" />
                        <TextBox Width="70"
                                 Margin="8,0,0,0"
                                 Text="{Binding Settings.QuietHoursStart, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="до" />
                        <TextBox Width="70"
                                 Margin="8,0,0,0"
                                 Text="{Binding Settings.QuietHoursEnd, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock Margin="0,12,0,0"
                               FontWeight="SemiBold"
                               Text="Пороги и антиспам" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Text="Диск, % свободно:" />
                        <TextBox Width="60"
                                 Margin="8,0,16,0"
                                 Text="{Binding Settings.LowDiskSpaceThresholdPercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Text="Батарея, %:" />
                        <TextBox Width="60"
                                 Margin="8,0,16,0"
                                 Text="{Binding Settings.BatteryLowThresholdPercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Text="Cooldown, мин:" />
                        <TextBox Width="60"
                                 Margin="8,0,16,0"
                                 Text="{Binding Settings.AlertCooldownMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Text="Тишина после старта, мин:" />
                        <TextBox Width="60"
                                 Margin="8,0,16,0"
                                 Text="{Binding Settings.StartupGracePeriodMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Text="Макс. алертов/час:" />
                        <TextBox Width="60"
                                 Margin="8,0,0,0"
                                 Text="{Binding Settings.MaxAlertsPerHour, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock VerticalAlignment="Center" Text="CPU, %:" />
                        <TextBox Width="60"
                                 Margin="8,0,16,0"
                                 Text="{Binding Settings.HighCpuThresholdPercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Text="Память, %:" />
                        <TextBox Width="60"
                                 Margin="8,0,16,0"
                                 Text="{Binding Settings.HighMemoryThresholdPercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Text="Журнал, дней:" />
                        <TextBox Width="60"
                                 Margin="8,0,0,0"
                                 Text="{Binding Settings.JournalRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FF666666"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="Срок хранения журнала: 0 — без автоочистки, 1–365 дней. Тишина после старта и лимит/час: 0 — выключено. Режим «только критичные» пропускает unexpected/BSOD/crash/hang/Defender/disk/failed logon/firewall/admin. Пользовательский снимок статуса проходит всегда." />
                    <TextBlock Margin="0,12,0,0"
                               FontWeight="SemiBold"
                               Text="Watchdog процессов" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FF666666"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="Имена через запятую, без пути: nginx, notepad, mysqld" />
                    <TextBox Margin="0,8,0,0"
                             Text="{Binding Settings.WatchedProcessNames, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,12,0,0"
                               FontWeight="SemiBold"
                               Text="Watchdog служб Windows" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FF666666"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="Service Name через запятую: Spooler, wuauserv, MSSQLSERVER" />
                    <TextBox Margin="0,8,0,0"
                             Text="{Binding Settings.WatchedServiceNames, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,12,0,0"
                               FontWeight="SemiBold"
                               Text="Ping watchdog хостов" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FF666666"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="Имена или IP через запятую: 8.8.8.8, nas.local, gateway" />
                    <TextBox Margin="0,8,0,0"
                             Text="{Binding Settings.WatchedHosts, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,12,0,0"
                               FontWeight="SemiBold"
                               Text="Пользовательские Event ID" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FF666666"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="Дополнительно следить за Event ID из System/Application/Security, например 7045, 7040" />
                    <TextBox Margin="0,8,0,0"
                             Text="{Binding Settings.CustomEventIds, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,12,0,0"
                               FontWeight="SemiBold"
                               Text="Шаблон сообщения (опционально)" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#FF666666"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="Плейсхолдеры: {Subject} {Host} {DisplayName} {MachineName} {Time} {Type} {Source} {EventId} {Message} {CorrelationId} {Uptime}" />
                    <TextBox Margin="0,8,0,0"
                             Height="72"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Settings.AlertBodyTemplate, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,16,0,0"
                               Foreground="#FFB00020"
                               TextWrapping="Wrap"
                               Text="{Binding Settings.ValidationMessage}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF005A20"
                               TextWrapping="Wrap"
                               Text="{Binding Settings.SaveResultMessage}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#FF1A1A8A"
                               TextWrapping="Wrap"
                               Text="{Binding Settings.TestResultMessage}" />

                    <WrapPanel Margin="0,16,0,0">
                        <Button Width="180"
                                Height="34"
                                Content="Сохранить настройки"
                                Command="{Binding Settings.SaveSettingsCommand}" />
                        <Button Width="180"
                                Height="34"
                                Margin="12,0,0,0"
                                Content="Тестовая отправка"
                                Command="{Binding Settings.SendTestAlertCommand}" />
                        <Button Width="180"
                                Height="34"
                                Margin="12,0,0,0"
                                Content="Экспорт настроек"
                                Command="{Binding Settings.ExportSettingsCommand}" />
                        <Button Width="180"
                                Height="34"
                                Margin="12,0,0,0"
                                Content="Импорт настроек"
                                Command="{Binding Settings.ImportSettingsCommand}" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="16"
                CornerRadius="8"
                Background="#FFFDFDFD"
                BorderBrush="#FFE3E3E3"
                BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Width="120"
                                Height="28"
                                Content="Обновить"
                                Command="{Binding RefreshJournalCommand}" />
                        <Button Width="140"
                                Height="28"
                                Margin="8,0,0,0"
                                Content="Экспорт CSV"
                                Command="{Binding ExportJournalCommand}" />
                        <Button Width="140"
                                Height="28"
                                Margin="8,0,0,0"
                                Content="Экспорт JSON"
                                Command="{Binding ExportJournalJsonCommand}" />
                        <Button Width="160"
                                Height="28"
                                Margin="8,0,0,0"
                                Content="Повторить outbox"
                                Command="{Binding RetryOutboxCommand}" />
                        <Button Width="140"
                                Height="28"
                                Margin="8,0,0,0"
                                Content="Очистить журнал"
                                Command="{Binding ClearJournalCommand}" />
                    </WrapPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="Журнал последних алертов" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Text="Фильтр:" />
                        <TextBox Height="28"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding JournalFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Фильтр журнала по типу, статусу, каналу или теме" />
                    </DockPanel>
                </StackPanel>
                <ListView ItemsSource="{Binding RecentAlerts}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Время" Width="150"
                                            DisplayMemberBinding="{Binding Timestamp}" />
                            <GridViewColumn Header="Тип" Width="120"
                                            DisplayMemberBinding="{Binding EventType}" />
                            <GridViewColumn Header="Статус" Width="80"
                                            DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="Канал" Width="90"
                                            DisplayMemberBinding="{Binding Channel}" />
                            <GridViewColumn Header="Тема" Width="240"
                                            DisplayMemberBinding="{Binding Subject}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</Window>
